# MedShare frontend environment
# Copy this file to `.env.local` for local development. Never commit real secrets.

# Which service implementation the app uses. This is the ONLY switch between
# the local prototype and the future backend. Supported values:
#   mock  (default) — fully local; services run against the in-browser store.
#   api             — resolves to the placeholders in src/services/http, which
#                     fail loudly with NOT_IMPLEMENTED (no backend exists yet).
# Any other value shows a clear configuration error instead of silently
# pretending a backend is connected.
VITE_DATA_MODE=mock

# Base URL of the future Spring Boot REST API.
# No requests are made while VITE_DATA_MODE=mock; this only pre-configures the
# Axios client (src/services/api/client.ts) for when the backend lands.
VITE_API_BASE_URL=http://localhost:8080/api

# Application runtime environment: development | production
VITE_APP_ENV=development
